# Backend configuration — copy to .env and adjust.
# --------------------------------------------------

# PostgreSQL connection (Supabase Postgres in production, local Postgres in dev).
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/church_service_scheduler?schema=public"
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.uyvefmomkbfgbmqlxnjx:[PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.uyvefmomkbfgbmqlxnjx:[PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"

# 'dev'  = local JWT auth (no external service, stores bcrypt hashes locally)
# 'supabase' = Supabase Auth (JWT verified with SUPABASE_JWT_SECRET)
AUTH_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# JWT verification: either the legacy shared JWT secret (HS256) or, for new
# Supabase projects, the JWKS URL (RS256). JWKS takes precedence when set.
SUPABASE_JWT_SECRET=""
SUPABASE_JWKS_URL=""
DEV_JWT_SECRET="dev-secret-change-me"

# 'console' = prints emails to stdout
# 'resend'  = sends real emails via Resend
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM=""

# Cron
CRON_SECRET=""
REMIND_CRON="0 8 * * *"

PORT=4000
NODE_ENV="prodcution"
