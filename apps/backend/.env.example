# Backend configuration — copy to .env and adjust.
# --------------------------------------------------

# PostgreSQL connection (Supabase Postgres in production, local Postgres in dev).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/church_service_scheduler?schema=public"

# 'dev'  = local JWT auth (no external service, stores bcrypt hashes locally)
# 'supabase' = Supabase Auth (JWT verified with SUPABASE_JWT_SECRET)
AUTH_PROVIDER="dev"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
DEV_JWT_SECRET="dev-secret-change-me"

# 'console' = prints emails to stdout
# 'resend'  = sends real emails via Resend
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Church Scheduler <onboarding@resend.dev>"

# Cron
CRON_SECRET="cron-secret-change-me"
REMIND_CRON="0 8 * * *"

PORT=4000
NODE_ENV="development"
